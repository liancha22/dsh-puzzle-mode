{
  "name": "dsh-puzzle-mode",
  "version": "0.6.0",
  "description": "DSH 插件：拼图模式——一个会话只绑一个拼图项目（主文档 + 若干模块文档），AI 主动提问把不确定项变成已定项，用五维（任务复杂度/可拓展性/维护系数/代码质量/可复用性）算项目健康性，带文档格式版本号与 op:rebuild 迁移、两种执行模式（只拼不写 / 边拼边写）与一个可表单直建项目/审查/绑定解绑的面板。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "test",
    "cordis.patch.yml",
    "README.md",
    "PUBLISH.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/10-puzzle.test.mjs && node test/20-client.test.mjs && node test/30-rpc.test.mjs && node test/40-pre-execute.test.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "puzzle",
    "project-docs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liancha22/dsh-puzzle-mode.git"
  },
  "homepage": "https://github.com/liancha22/dsh-puzzle-mode#readme",
  "bugs": {
    "url": "https://github.com/liancha22/dsh-puzzle-mode/issues"
  },
  "author": "liancha22 <1784351702@qq.com>"
}
